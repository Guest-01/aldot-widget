<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 아이콘 앞면: 반원 계기판 + 가운데 점("남았닷"의 닷). 앱 홈 위쪽 계기판과 같은 모양.
  108 단위 캔버스지만 런처는 가운데 72만 보여 준다. 시안(108 전체를 보여 줌)과 같은 비율이 되도록
  그림 전체를 가운데 기준 2/3로 줄인다.
  테마 아이콘(monochrome)도 이 그림을 쓴다. 시스템은 알파값만 보므로 옅은 바탕 선은 옅게 나온다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.6667"
        android:scaleY="0.6667">
        <!-- 계기판 바탕 선 (흰색 32%) -->
        <path
            android:pathData="M28,62 A26,26 0 0,1 80,62"
            android:strokeColor="#52FFFFFF"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <!-- 남은 양 (62%) -->
        <path
            android:pathData="M28,62 A26,26 0 0,1 63.6,37.8"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <!-- 가운데 점 -->
        <path
            android:pathData="M48.5,62 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
