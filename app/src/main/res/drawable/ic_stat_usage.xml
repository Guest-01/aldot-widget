<?xml version="1.0" encoding="utf-8"?>
<!-- 상태 표시줄 알림 아이콘: 앱 아이콘(ic_launcher_foreground)과 같은 반원 계기판 + 남은 양 + 가운데 점.
     시스템이 한 색으로 칠하고 투명도만 남기므로, 바탕 선은 옅게(40%) 보인다.
     (예전에는 신호 막대 모양이었는데 상태 표시줄의 신호 세기 아이콘과 헷갈려서 바꿨다) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 계기판 바탕 선 -->
    <path
        android:pathData="M4,16 A8,8 0 0,1 20,16"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <!-- 남은 양 (앱 아이콘과 같은 62%) -->
    <path
        android:pathData="M4,16 A8,8 0 0,1 14.94,8.56"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
    <!-- 가운데 점 -->
    <path
        android:pathData="M9.9,16 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0"
        android:fillColor="#FFFFFFFF" />
</vector>
